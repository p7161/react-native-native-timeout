{
  "name": "react-native-native-timeout",
  "version": "0.1.0",
  "description": "Cross-platform native-backed timeout implementation for React Native",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/example/react-native-native-timeout.git"
  },
  "main": "lib/commonjs/index.js",
  "module": "lib/commonjs/index.js",
  "types": "lib/typescript/src/index.d.ts",
  "react-native": "src/index.ts",
  "files": [
    "lib",
    "src",
    "ios",
    "android",
    "README.md",
    "LICENSE",
    "react-native-native-timeout.podspec"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf lib",
    "lint": "eslint .",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "keywords": [
    "react-native",
    "timeout",
    "native"
  ],
  "author": "",
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-native": ">=0.71.0"
  },
  "devDependencies": {
    "@react-native/eslint-config": "^0.72.2",
    "@testing-library/react-native": "^12.5.0",
    "@types/jest": "^29.5.3",
    "@types/react": "^18.2.14",
    "@types/react-native": "^0.73.0",
    "@typescript-eslint/eslint-plugin": "^6.2.1",
    "@typescript-eslint/parser": "^6.2.1",
    "eslint": "^8.47.0",
    "jest": "^29.6.2",
    "metro-react-native-babel-preset": "^0.76.7",
    "prettier": "^3.0.1",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.1",
    "typescript": "^5.1.6",
    "react": "18.2.0",
    "react-native": "0.72.4"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/__tests__"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "json",
      "jsx"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "timers": "fake"
  }
}
